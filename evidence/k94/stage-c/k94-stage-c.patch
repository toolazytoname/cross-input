+
+static void k94_via_switch_execute_request(uint8_t target, bool pressed) {
+    keyrecord_t record = {0};
+    record.event.pressed = pressed;
+    uint16_t keycode = MD_BLE3;
+    if (target == 1) {
+        keycode = MD_BLE1;
+    } else if (target == 2) {
+        keycode = MD_BLE2;
+    }
+    (void)process_record_user(keycode, &record);
+}
